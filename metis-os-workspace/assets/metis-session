#!/usr/bin/env bash
# Metis standalone session launcher (Stage C.5).
#
# This is the entry point a login manager (GDM, SDDM, greetd, …) runs when you
# pick "Metis" from the session list — analogous to Hyprland's `Hyprland`
# session wrapper. The display manager has already given us our own VT and a
# logind seat, so libseat can take DRM master cleanly; on exit we drop straight
# back to the greeter.
#
# It sets the desktop identity, pins the DRM backend, exports the session
# environment to the user D-Bus / systemd activation environment (so portals and
# activated apps land in this session), then supervises the compositor: unclean
# exits restart in-session with optional window restore (see session-restore ADR);
# clean logout returns to the greeter.

set -uo pipefail

# --- desktop identity -------------------------------------------------------
# Keep "Metis" first so the Metis xdg-desktop-portal backend (UseIn=Metis) and
# its preferred-portals config still win. The trailing ":GNOME" is purely so
# Chromium/Electron apps (Cursor, GitHub Desktop, browsers) auto-detect the
# gnome-libsecret credential backend instead of falling back to plaintext
# ("encryption is low"). No Metis code keys off this value.
export XDG_CURRENT_DESKTOP="Metis:GNOME"
export XDG_SESSION_DESKTOP="metis"
export XDG_SESSION_TYPE="wayland"

# --- backend ---------------------------------------------------------------
# Pin the standalone DRM/KMS backend regardless of autodetection.
export METIS_BACKEND="drm"

# --- Flatpak app visibility -------------------------------------------------
# Flatpak installs export their `.desktop` entries and icons under dedicated
# `exports/share` trees, NOT the system applications dir. GIO (and therefore the
# Metis launcher and running-apps dock, which enumerate via `gio::AppInfo`) only
# see them when those trees are on XDG_DATA_DIRS. Most distros add these via
# `/etc/profile.d/flatpak.sh`, but a login-manager session frequently does not
# source profile scripts, so Flatpak apps silently go missing. Ensure the export
# dirs are present here (harmless when Flatpak is absent — the dirs just will not
# exist). XDG_DATA_DIRS is already forwarded to the activation environment below.
metis_add_data_dir() {
    local dir="$1"
    case ":${XDG_DATA_DIRS:-}:" in
        *":$dir:"*) : ;; # already present — keep the existing ordering
        *) XDG_DATA_DIRS="${XDG_DATA_DIRS:+$XDG_DATA_DIRS:}$dir" ;;
    esac
}
# Seed the freedesktop default if the login stack left it unset.
export XDG_DATA_DIRS="${XDG_DATA_HOME:-$HOME/.local/share}:/usr/local/share:/usr/share"
metis_add_data_dir "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share"
metis_add_data_dir "/var/lib/flatpak/exports/share"
metis_add_data_dir "/var/lib/snapd/desktop"
# Prepend Metis share so dbus-1/services/org.freedesktop.secrets.service under
# …/metis/ wins over gnome-keyring's system copy without replacing that file.
# Packaging may inject an extra prepend (Nix store path) at the marker below.
metis_prepend_data_dir() {
    local dir="$1"
    [[ -d "$dir" ]] || return 0
    case ":${XDG_DATA_DIRS:-}:" in
        *":$dir:"*) : ;;
        *) XDG_DATA_DIRS="$dir${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}" ;;
    esac
}
if [[ -n "${METIS_SHARE_DIR:-}" ]]; then
    metis_prepend_data_dir "$METIS_SHARE_DIR"
fi
: # metis-share-dirs
metis_prepend_data_dir "/usr/local/share/metis"
metis_prepend_data_dir "/usr/share/metis"
export XDG_DATA_DIRS

# GTK shell: prefer the Wayland backend.
export GDK_BACKEND="${GDK_BACKEND:-wayland}"
# Some GPU/driver combos hang GTK's GL renderer under a fresh compositor; the
# Cairo renderer is a safe default for Metis shell. Override via
# METIS_SHELL_GSK_RENDERER (or GSK_RENDERER) before launch if GL is reliable.
export METIS_SHELL_GSK_RENDERER="${METIS_SHELL_GSK_RENDERER:-${GSK_RENDERER:-cairo}}"
export GSK_RENDERER="${GSK_RENDERER:-$METIS_SHELL_GSK_RENDERER}"

# --- Electron / Chromium: prefer native Wayland ----------------------------
# Metis is a Wayland compositor; its XWayland path is a fallback. Electron/Ozone
# apps default to XWayland unless hinted otherwise, and their XWayland map/unmap
# lifecycle is flaky under nested/self-managed WMs (observed: Claude Desktop's
# window juggling ends in a clean `window-all-closed` quit — it opens and
# immediately closes). Native Wayland is stable and avoids the XWayland round
# trip entirely, so we opt apps into it:
#   * ELECTRON_OZONE_PLATFORM_HINT=auto — the standard switch most Electron apps
#     (Cursor, VS Code, Discord, Signal, …) honor to pick Wayland when present.
#   * CLAUDE_USE_WAYLAND=1 — Claude Desktop's launcher force-passes
#     `--ozone-platform=x11` and only respects native Wayland via this opt-in.
# Both are overridable so a user can force XWayland per-app if a specific app
# renders better there.
export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
export CLAUDE_USE_WAYLAND="${CLAUDE_USE_WAYLAND:-1}"

# --- GTK startup hardening for a standalone (non-GNOME) session ------------
# Metis serves org.freedesktop.portal.Settings via metis-portal (started by the
# compositor). The AT-SPI accessibility bus is still disabled — GTK connects to
# org.a11y.Bus at startup and can hang when no bus exists in a bare session.
# The compositor also spawns metis-shell with GDK_DEBUG=no-portals so the edge
# bar never blocks ~25s on a leftover greeter portal during gtk::init.
export GTK_A11Y="${GTK_A11Y:-none}"
export NO_AT_BRIDGE="${NO_AT_BRIDGE:-1}"

# Default logging if the session leaves it unset.
export RUST_LOG="${RUST_LOG:-metis_shell=debug,metis_compositor=info,warn}"

# --- Input method (Fcitx5 preferred; IBus fallback) ------------------------
# Metis advertises text-input-v3 / input-method-v2; the framework is a distro
# package (Recommends: fcitx5). Set module env for XWayland/GTK/Qt unless the
# user already configured them. Native Wayland clients talk IM via the
# compositor protocols.
#
# Important: do **not** start the IM daemon before the compositor creates its
# Wayland socket. Fcitx5/IBus bind `zwp_input_method_v2` as Wayland clients; a
# daemon left over from a prior seat (or started with no WAYLAND_DISPLAY) never
# rebinds and CJK candidates silently fail. Export module env early, then
# (re)start the daemon once a wayland-* socket exists (see metis_ensure_ime).
metis_ime_env() {
    if command -v fcitx5 >/dev/null 2>&1; then
        export GTK_IM_MODULE="${GTK_IM_MODULE:-fcitx}"
        export QT_IM_MODULE="${QT_IM_MODULE:-fcitx}"
        export XMODIFIERS="${XMODIFIERS:-@im=fcitx}"
        return 0
    fi
    if command -v ibus-daemon >/dev/null 2>&1; then
        export GTK_IM_MODULE="${GTK_IM_MODULE:-ibus}"
        export QT_IM_MODULE="${QT_IM_MODULE:-ibus}"
        export XMODIFIERS="${XMODIFIERS:-@im=ibus}"
        return 0
    fi
    return 0
}

# Wait for the compositor Wayland socket, then restart Fcitx5/IBus so
# input-method-v2 binds *this* display. Runs in the background (non-blocking).
metis_ensure_ime() {
    (
        local runtime display sock tries=0
        runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        display=""
        while (( tries < 75 )); do
            if [[ -n "${WAYLAND_DISPLAY:-}" && -S "${runtime}/${WAYLAND_DISPLAY}" ]]; then
                display="$WAYLAND_DISPLAY"
                break
            fi
            shopt -s nullglob
            for sock in "${runtime}"/wayland-*; do
                if [[ -S "$sock" ]]; then
                    display="$(basename "$sock")"
                    break 2
                fi
            done
            sleep 0.2
            tries=$((tries + 1))
        done
        if [[ -z "$display" ]]; then
            echo "metis-session: IME skipped — no Wayland socket after wait" >&2
            exit 0
        fi
        export WAYLAND_DISPLAY="$display"
        if command -v fcitx5 >/dev/null 2>&1; then
            export GTK_IM_MODULE="${GTK_IM_MODULE:-fcitx}"
            export QT_IM_MODULE="${QT_IM_MODULE:-fcitx}"
            export XMODIFIERS="${XMODIFIERS:-@im=fcitx}"
            pkill -u "$(id -u)" -x fcitx5 >/dev/null 2>&1 || true
            sleep 0.2
            fcitx5 -d >/dev/null 2>&1 &
            echo "metis-session: started fcitx5 (WAYLAND_DISPLAY=${display})" >&2
            exit 0
        fi
        if command -v ibus-daemon >/dev/null 2>&1; then
            export GTK_IM_MODULE="${GTK_IM_MODULE:-ibus}"
            export QT_IM_MODULE="${QT_IM_MODULE:-ibus}"
            export XMODIFIERS="${XMODIFIERS:-@im=ibus}"
            pkill -u "$(id -u)" -x ibus-daemon >/dev/null 2>&1 || true
            sleep 0.2
            ibus-daemon -drx >/dev/null 2>&1 &
            echo "metis-session: started ibus-daemon (WAYLAND_DISPLAY=${display})" >&2
            exit 0
        fi
        exit 0
    ) &
}

metis_stop_ime() {
    pkill -u "$(id -u)" -x fcitx5 >/dev/null 2>&1 || true
    pkill -u "$(id -u)" -x ibus-daemon >/dev/null 2>&1 || true
}

metis_ime_env

# --- secret service / keyring ----------------------------------------------
# Metis owns the default provider (`metis-secretsd` → org.freedesktop.secrets).
# If another provider already owns the bus, leave it alone. Fallbacks are
# DE-agnostic first; gnome-keyring is last resort only.
# See docs/decisions/secret-service-provider.md
ks_log() { echo "metis-session: keyring: $*" >&2; }

# True only when the name is already owned (do not treat activatable .service
# files as "running" — that would skip starting metis-secretsd when a third-party
# activatable unit is installed but idle).
metis_secrets_bus_owned() {
    if command -v busctl >/dev/null 2>&1 \
        && busctl --user status org.freedesktop.secrets >/dev/null 2>&1; then
        return 0
    fi
    if command -v gdbus >/dev/null 2>&1 \
        && gdbus call --session --dest org.freedesktop.DBus \
            --object-path /org/freedesktop/DBus \
            --method org.freedesktop.DBus.NameHasOwner org.freedesktop.secrets \
            2>/dev/null | grep -q true; then
        return 0
    fi
    return 1
}

metis_start_secret_service() {
    if metis_secrets_bus_owned; then
        ks_log "org.freedesktop.secrets already owned — leaving third-party provider"
        return 0
    fi
    if command -v metis-secretsd >/dev/null 2>&1; then
        metis-secretsd >/dev/null 2>&1 &
        # Brief wait so the name is claimed before clients start.
        sleep 0.15
        if metis_secrets_bus_owned; then
            ks_log "started metis-secretsd"
            return 0
        fi
        ks_log "WARNING: metis-secretsd did not claim the bus — trying fallbacks"
    fi
    if command -v pass-secret-service >/dev/null 2>&1; then
        pass-secret-service >/dev/null 2>&1 &
        ks_log "started pass-secret-service"
    elif command -v keepassxc >/dev/null 2>&1; then
        keepassxc >/dev/null 2>&1 &
        ks_log "started KeePassXC (enable Secret Service integration in its settings)"
    elif command -v kwalletd6 >/dev/null 2>&1; then
        kwalletd6 >/dev/null 2>&1 &
        ks_log "started kwalletd6 (KWallet Secret Service)"
    elif command -v kwalletd5 >/dev/null 2>&1; then
        kwalletd5 >/dev/null 2>&1 &
        ks_log "started kwalletd5 (KWallet Secret Service)"
    elif command -v gnome-keyring-daemon >/dev/null 2>&1; then
        eval "$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null)"
        export SSH_AUTH_SOCK
        ks_log "started gnome-keyring-daemon (fallback)"
    else
        ks_log "WARNING: no Secret Service provider — apps may store credentials in plaintext"
        ks_log "         Metis packages metis-secretsd; ensure it is on PATH"
    fi
}
metis_start_secret_service

# --- OpenSSH agent (Phase 22 §C) --------------------------------------------
# When Metis owns secrets (or always for Metis sessions), ensure an ssh-agent
# so vault-backed keys can be loaded after unlock. Do not clobber a pre-set agent.
metis_ensure_ssh_agent() {
    if [[ -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK}" ]]; then
        ks_log "SSH_AUTH_SOCK already set — leaving existing agent"
        return 0
    fi
    if ! command -v ssh-agent >/dev/null 2>&1; then
        ks_log "ssh-agent not on PATH — install openssh-client for SSH keys"
        return 0
    fi
    eval "$(ssh-agent -s)" >/dev/null
    export SSH_AUTH_SOCK SSH_AGENT_PID
    if command -v metis-ssh-askpass >/dev/null 2>&1; then
        export SSH_ASKPASS="$(command -v metis-ssh-askpass)"
        export SSH_ASKPASS_REQUIRE="${SSH_ASKPASS_REQUIRE:-prefer}"
    fi
    ks_log "started ssh-agent (SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-})"
}
metis_ensure_ssh_agent

# --- remote desktop autostart (Phase 7) ------------------------------------
# Best-effort: when remote.json has enabled + auto_start, start headless RDP.
# Skipped in nested/dev sessions unless METIS_BACKEND=drm (real login session).
metis_remote_autostart() {
    if [[ "${METIS_BACKEND:-}" != "drm" ]]; then
        return 0
    fi
    if ! command -v metis-remote >/dev/null 2>&1; then
        return 0
    fi
    metis-remote autostart 2>/dev/null || true
}
metis_remote_autostart

# --- session log -----------------------------------------------------------
# A login-manager session has no terminal, so capture compositor + shell output
# to a file (the shell inherits these fds). Read it after a failed run:
#   ~/.local/state/metis/logs/session-latest.log
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/metis/logs"
mkdir -p "$LOG_DIR" 2>/dev/null || true
SESSION_LOG="$LOG_DIR/session-$(date +%Y%m%d-%H%M%S).log"
ln -sfn "$SESSION_LOG" "$LOG_DIR/session-latest.log" 2>/dev/null || true

# --- locate the compositor -------------------------------------------------
# Installed layout puts metis-compositor + metis-shell side by side; the
# compositor resolves metis-shell next to itself. Fall back to PATH.
SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -x "$SELF_DIR/metis-compositor" ]]; then
    COMP_BIN="$SELF_DIR/metis-compositor"
else
    COMP_BIN="$(command -v metis-compositor || true)"
fi
if [[ -z "${COMP_BIN:-}" ]]; then
    echo "metis-session: metis-compositor not found in $SELF_DIR or PATH" >&2
    exit 127
fi

# --- activation environment ------------------------------------------------
# Hand our session env to systemd --user and D-Bus so portals / activated apps
# run inside Metis. Best-effort: a session may not have a user bus yet.
# Re-run after each compositor restart — WAYLAND_DISPLAY may change.
SESSION_VARS=(
    WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
    XDG_SESSION_ID DISPLAY GDK_BACKEND METIS_SHELL_GSK_RENDERER GTK_A11Y NO_AT_BRIDGE
    SSH_AUTH_SOCK XDG_DATA_DIRS XDG_CONFIG_DIRS
    ELECTRON_OZONE_PLATFORM_HINT CLAUDE_USE_WAYLAND
    GTK_IM_MODULE QT_IM_MODULE XMODIFIERS
    METIS_SESSION_RESTORE
)
metis_export_activation_env() {
    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        dbus-update-activation-environment --systemd "${SESSION_VARS[@]}" 2>/dev/null || true
    elif command -v systemctl >/dev/null 2>&1; then
        systemctl --user import-environment "${SESSION_VARS[@]}" 2>/dev/null || true
    fi
}
metis_export_activation_env

# --- compositor supervisor (maturity M1) -----------------------------------
# Stay in the login session across unclean compositor exits. Clean logout
# (session-clean-exit marker or exit 0) returns to the greeter. ≥3 failures
# within 60s abort the loop so a bad GPU/driver cannot spin forever.
# See docs/decisions/session-restore.md.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/metis"
mkdir -p "$STATE_DIR" 2>/dev/null || true
CLEAN_MARKER="$STATE_DIR/session-clean-exit"
RESTART_TIMES="$STATE_DIR/session-restart-times"
CRASH_WINDOW_SECS=60
CRASH_MAX=3

metis_crash_loop_tripped() {
    local now cutoff
    now="$(date +%s)"
    cutoff=$((now - CRASH_WINDOW_SECS))
    if [[ ! -f "$RESTART_TIMES" ]]; then
        return 1
    fi
    # Keep timestamps inside the window, count them.
    local kept=()
    local t
    while IFS= read -r t; do
        [[ -z "$t" ]] && continue
        if [[ "$t" =~ ^[0-9]+$ ]] && (( t >= cutoff )); then
            kept+=("$t")
        fi
    done <"$RESTART_TIMES"
    if ((${#kept[@]} >= CRASH_MAX)); then
        printf '%s\n' "${kept[@]}" >"$RESTART_TIMES" 2>/dev/null || true
        return 0
    fi
    printf '%s\n' "${kept[@]}" >"$RESTART_TIMES" 2>/dev/null || true
    return 1
}

metis_record_unclean_exit() {
    date +%s >>"$RESTART_TIMES" 2>/dev/null || true
}

attempt=0
while true; do
    rm -f "$CLEAN_MARKER" 2>/dev/null || true
    unset METIS_SESSION_RESTORE

    if (( attempt > 0 )); then
        export METIS_SESSION_RESTORE=1
        {
            echo "--- compositor restart ${attempt} (METIS_SESSION_RESTORE=1) $(date -Is) ---"
        } >>"$SESSION_LOG"
        # Brief pause so libseat/DRM can settle after an abrupt death.
        sleep 0.4 2>/dev/null || true
    else
        {
            echo "--- compositor start $(date -Is) ---"
        } >>"$SESSION_LOG"
    fi

    metis_export_activation_env
    # Bind / rebind Fcitx5|IBus to this compositor's Wayland socket (async).
    metis_ensure_ime

    "$COMP_BIN" "$@" >>"$SESSION_LOG" 2>&1
    code=$?

    # Drop the IM so a supervised restart cannot keep a daemon on a dead socket.
    metis_stop_ime

    attempt=$((attempt + 1))

    if [[ -f "$CLEAN_MARKER" ]] || [[ "$code" -eq 0 ]]; then
        rm -f "$CLEAN_MARKER" 2>/dev/null || true
        rm -f "$RESTART_TIMES" 2>/dev/null || true
        {
            echo "--- compositor clean exit (code=${code}) $(date -Is) ---"
        } >>"$SESSION_LOG"
        exit 0
    fi

    metis_record_unclean_exit
    {
        echo "--- compositor unclean exit (code=${code}) $(date -Is); supervising restart ---"
    } >>"$SESSION_LOG"

    if metis_crash_loop_tripped; then
        {
            echo "metis-session: crash-loop brake — ${CRASH_MAX}+ unclean exits in ${CRASH_WINDOW_SECS}s; returning to greeter"
        } | tee -a "$SESSION_LOG" >&2
        exit 1
    fi
done
